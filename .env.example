# Copy this file to `.env.local` and fill in values from your Supabase project
# (Project Settings → API). The app still runs without these — the track picker
# and form work in demo mode — but orders will not be saved to the database.

# Public URL of your Supabase project (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous (public) API key. Used for reading the tracks catalog.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER ONLY — never prefix this with NEXT_PUBLIC_.
# Used to insert customers/orders/books and upload photos, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key. SERVER ONLY — never prefix this with NEXT_PUBLIC_.
# Used to generate personalized story text after an order is saved.
ANTHROPIC_API_KEY=your-anthropic-api-key
